/**
 * SQLite connection
 * datasource db {
 * provider = "sqlite"
 * url      = "file:./dev.db"
 * }
 */

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id          Int          @id @default(autoincrement())
  email       String       @unique
  userName    String       @unique
  password    String
  firstName   String
  lastName    String?
  picture     Bytes?
  connections Connection[]
  groups      Group[]
}
