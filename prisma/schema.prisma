//to apply schema to database (npx prisma migrate dev --name init)
// Redis https://aiven.io/free-redis-database
// Postgresql https://neon.tech/pricing

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  name          String?
  password      String
  image         String?
  memberships   GroupMember[]
  personalChats PersonalChat[] @relation("PersonalChatParticipants")
  sentMessages  Message[]
  ownedGroups   Group[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model PersonalChat {
  id           String    @id @default(cuid())
  participants User[]    @relation("PersonalChatParticipants")
  messages     Message[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Group {
  id          String        @id @default(cuid())
  name        String
  description String?
  image       String?
  isPrivet    Boolean       @default(false)
  owner       User          @relation(fields: [ownerId], references: [id])
  ownerId     String
  members     GroupMember[]
  messages    Message[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model GroupMember {
  id       String    @id @default(cuid())
  group    Group     @relation(fields: [groupId], references: [id])
  groupId  String
  user     User      @relation(fields: [userId], references: [id])
  userId   String
  role     GroupRole @default(MEMBER)
  joinedAt DateTime  @default(now())

  @@unique([groupId, userId])
}

enum GroupRole {
  OWNER
  ADMIN
  MEMBER
}

model Message {
  id             String        @id @default(cuid())
  content        String
  sender         User          @relation(fields: [senderId], references: [id])
  senderId       String
  chat           PersonalChat? @relation(fields: [personalChatId], references: [id])
  personalChatId String?
  group          Group?        @relation(fields: [groupId], references: [id])
  groupId        String?
  attachments    Attachment[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([personalChatId])
  @@index([groupId])
}

model Attachment {
  id           String   @id @default(cuid())
  fileName     String
  fileUrl      String
  fileType     FileType
  fileSize     Int
  thumbnailUrl String?
  message      Message  @relation(fields: [messageId], references: [id])
  messageId    String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([messageId])
  @@index([fileUrl])
}

enum FileType {
  PHOTO
  VIDEO
  AUDIO
  FILE
}
