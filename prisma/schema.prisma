/**
 * SQLite connection
 * datasource db {
 * provider = "sqlite"
 * url      = "file:./dev.db"
 * }
 */

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id          Int          @id @default(autoincrement())
  email       String       @unique
  userName    String       @unique
  password    String
  firstName   String
  lastName    String?
  picture     Bytes?
  connections Connection[]
  groups      Group[]
}

model Connection {
  id           Int       @id @default(autoincrement())
  firstUserId  Int
  secondUserId Int
  // see 1-to-many and many-to-many with limit of tow
  firstUser    User      @relation(name: "user1", fields: [firstUserId], references: [id])
  secondUser   User      @relation(name: "user2", fields: [secondUserId], references: [id])
  messages     Message[]
}

model Message {
  id Int @id @default(autoincrement())
}
