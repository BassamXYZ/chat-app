/**
 * SQLite connection
 * datasource db {
 * provider = "sqlite"
 * url      = "file:./dev.db"
 * }
 */

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id          Int          @id @default(autoincrement())
  email       String       @unique
  userName    String       @unique
  password    String
  firstName   String
  lastName    String?
  picture     Bytes?
  connections Connection[]
  groups      Group[]
  messages    Message[]
}

model Connection {
  id       Int       @id @default(autoincrement())
  // see 1-to-many and many-to-many with limit of tow
  users    User[]
  messages Message[]
}

model Group {
  id       Int       @id @default(autoincrement())
  name     String
  privet   Boolean
  picture  Bytes
  members  User[]
  messages Message[]
}

model Message {
  id           Int        @id @default(autoincrement())
  content      String?
  authorId     Int
  author       User       @relation(fields: [authorId], references: [id])
  connectionId Int
  connection   Connection @relation(fields: [connectionId], references: [id])
  gruopId      Int
  gruop        Group      @relation(fields: [gruopId], references: [id])
  date         DateTime   @default(now())
  file         Bytes
}

//npx prisma migrate dev --name init (to apply schema to database)
